# Flask
PORT=5000
FLASK_ENV=production
TEMP_DIR=./temp
TASK_TIMEOUT=1800
CLEANUP_INTERVAL=3600
LOG_LEVEL=INFO

# YouTube cookies (optional)
COOKIES_FILE=./cookies.txt
# COOKIES_BASE64=

# Conversion email notifications
CONVERSION_NOTIFY_ENABLED=true
CONVERSION_NOTIFY_EMAIL=info.producertools@gmail.com
# Railway Hobby: use Resend (SMTP ports blocked)
EMAIL_PROVIDER=resend
RESEND_API_KEY=re_your_resend_api_key
RESEND_FROM=YTConverter <onboarding@resend.dev>
# VPS/local: use SMTP instead (leave RESEND_API_KEY empty)
# EMAIL_PROVIDER=smtp
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USE_TLS=true
SMTP_USER=your-sender@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_FROM=your-sender@gmail.com

# Database (optional)
# DB_HOST=localhost
# DB_PORT=3306
# DB_USER=root
# DB_PASSWORD=
# DB_NAME=ytconverter
